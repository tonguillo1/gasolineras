# Token que da @BotFather al crear el bot
TELEGRAM_TOKEN=123456:AA...

# Opcional pero recomendado: solo estos IDs de Telegram pueden usar el bot.
# Para saber el tuyo, habla con @userinfobot. Varios separados por comas.
# Sin esto, cualquiera que encuentre el bot puede consultarlo.
GASOLINERAS_ALLOWED_IDS=

# Opcionales
# GASOLINERAS_CACHE=/var/lib/gasolineras
# GASOLINERAS_TTL=1800
